# --- 機密の混入防止（CLAUDE.md INV-6） ---
# 実業務の PDF が Public リポジトリに入ると取り返しがつかない。
# テストフィクスチャのみ明示的に許可する。
*.pdf
!src/test/resources/**/*.pdf
!**/src/test/resources/**/*.pdf

*.key
*.pem
*.p12
*.pfx
.env
.env.*
credentials.*

# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
gradle-app.setting
.gradletasknamecache

# --- Java ---
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# --- jpackage 成果物 ---
*.msi
*.exe
/dist/

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/
out/

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

